{
  "id": "cue",
  "name": "Cuaderno de Campo (CUE)",
  "display_name": "CUE — Cuaderno de Campo",
  "version": "0.2.0",
  "description": "SIEX-compliant Cuaderno de Explotacion Unico para Espana (RD 1054/2022)",
  "short_description": "SIEX-compliant field notebook for Spanish agriculture",
  "author": {
    "name": "Nekazari Team",
    "email": "nekazari@robotika.cloud",
    "organization": "Nekazari"
  },
  "category": "agriculture",
  "module_type": "ADDON_FREE",
  "required_plan_type": "basic",
  "pricing_tier": "FREE",
  "route_path": "/cue",
  "label": "CUE",
  "icon": "book-open",
  "license": "AGPL-3.0",
  "accent": {
    "base": "#EF4444",
    "soft": "#FEE2E2",
    "strong": "#B91C1C"
  },
  "required_roles": ["Farmer", "TenantAdmin"],
  "dependencies": {
    "sdk_version": "^1.0.0",
    "react_version": "^18.3.1",
    "platform_version": "^2.0.0",
    "services": ["postgresql", "orion-ld"],
    "extensions": ["postgis"]
  },
  "permissions": {
    "api_access": ["/api/cue/*"],
    "storage_access": false,
    "external_requests": []
  },
  "build_config": {
    "type": "iife",
    "remote_entry_url": "/modules/cue/nkz-module.js"
  },
  "slots": {
    "context-panel": ["CUEMainPanel"],
    "map-layer": ["CUEEnclosureLayer"],
    "layer-toggle": [],
    "bottom-panel": [],
    "entity-tree": []
  },
  "surfaces": {
    "web": {
      "slots": {
        "context-panel": [
          {
            "id": "cue-main-panel",
            "moduleId": "cue",
            "component": "CUEMainPanel",
            "priority": 100
          }
        ],
        "map-layer": [
          {
            "id": "cue-enclosure-layer",
            "moduleId": "cue",
            "component": "CUEEnclosureLayer",
            "priority": 90
          }
        ],
        "layer-toggle": [],
        "bottom-panel": [],
        "entity-tree": []
      }
    }
  },
  "metadata": {
    "icon": "📘",
    "color": "#EF4444",
    "features": [
      "SIEX-compliant digital field notebook (RD 1054/2022)",
      "Explotacion, tratamiento, fertilizacion management",
      "IUWS submission with certificate-based mTLS signing",
      "Recinto (enclosure) polygon visualization on map"
    ],
    "screenshots": []
  },
  "config": {
    "country": "ES",
    "siex_version": "1.0"
  }
}
